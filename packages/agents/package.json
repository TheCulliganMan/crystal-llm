{
  "name": "@pokecrystal/agents",
  "version": "1.1.0",
  "description": "Pokemon Crystal gameplay agent package shell pending rebuild",
  "license": "ISC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pokecrystal-agents": "./dist/bin/pokecrystal-agents.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "packageManager": "npm@11.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheCulliganMan/crystal-llm.git"
  },
  "bugs": {
    "url": "https://github.com/TheCulliganMan/crystal-llm/issues"
  },
  "homepage": "https://github.com/TheCulliganMan/crystal-llm#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.5.0"
  },
  "scripts": {
    "build": "rm -rf dist && node ../../apps/web/scripts/run-with-bundled-node.js ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "typecheck": "npm run lint:types",
    "lint:types": "node ../../apps/web/scripts/run-with-bundled-node.js ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../apps/web/scripts/run-with-bundled-node.js ../../node_modules/jest/bin/jest.js --config jest.config.cjs"
  },
  "dependencies": {
    "@mastra/core": "^1.25.0",
    "@mastra/libsql": "^1.8.1",
    "@mastra/mcp": "^1.5.0",
    "@mastra/memory": "^1.15.1",
    "zod": "^4.3.6"
  }
}
