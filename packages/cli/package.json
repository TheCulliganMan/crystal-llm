{
  "name": "@pokecrystal/cli",
  "version": "1.0.0",
  "description": "CLI, stdio MCP proxy, and text UI for the PokeCrystal TypeScript runtime",
  "license": "ISC",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pokecrystal-cli": "./dist/bin/pokecrystal-cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server.json": "./server.json",
    "./skill": "./skills/pokecrystal-cli/SKILL.md"
  },
  "files": [
    "dist",
    "README.md",
    "server.json",
    "skills"
  ],
  "packageManager": "npm@11.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/pokecrystal-python.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/pokecrystal-python/issues"
  },
  "homepage": "https://github.com/OWNER/pokecrystal-python#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.5.0"
  },
  "scripts": {
    "build": "rm -rf dist && node ../../apps/web/scripts/run-with-bundled-node.js ../../node_modules/typescript/bin/tsc -p tsconfig.build.json && chmod +x dist/bin/pokecrystal-cli.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "npm run lint:types",
    "lint:types": "node ../../apps/web/scripts/run-with-bundled-node.js ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../apps/web/scripts/run-with-bundled-node.js ../../node_modules/jest/bin/jest.js --config jest.config.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pokecrystal/core": "file:../core",
    "ink": "^6.8.0",
    "react": "^19.2.3",
    "zod": "^4.2.1"
  }
}
