{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "noEmit": true,
    "lib": [
      "esnext"
    ],
    "paths": {
      "@pokecrystal/cli": [
        "packages/cli/src/index.ts"
      ],
      "@pokecrystal/cli/*": [
        "packages/cli/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
