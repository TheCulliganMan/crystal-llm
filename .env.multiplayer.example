# Public port on the Docker host.
POKECRYSTAL_PORT=3003

# Required before exposing the server publicly. Generate with:
#   openssl rand -hex 32
CRYSTAL_SERVER_TOKEN=replace-with-a-long-random-token

# For a public host, clear CRYSTAL_SERVER_TOKEN and set this instead. Signed
# user tokens bind each connection to one player id and cannot impersonate a
# different player. Use at least 32 random bytes.
CRYSTAL_AUTH_SECRET=

# Optional exact allowlist: comma-separated runtime modpack id=content hash pairs.
# With an empty value, every valid identity is accepted but players are still
# isolated by exact world id, modpack id, and content hash.
CRYSTAL_MODPACKS=

# Hard connection ceiling. The Compose nofile limit supports this default plus
# listener/files/overhead; lower it for small hosts.
CRYSTAL_MAX_CLIENTS=20000

RUST_LOG=crystal_web_server=info,tower_http=info
