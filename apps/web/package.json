{
  "name": "@pokecrystal/web",
  "version": "1.0.0",
  "description": "ASM-faithful TypeScript runner for the PokeCrystal engine",
  "main": "dist/index.js",
  "packageManager": "npm@11.3.0",
  "scripts": {
    "prebuild": "node scripts/run-with-bundled-node.js scripts/sync-workspace-runtime.js && node scripts/run-with-bundled-node.js scripts/emit-package-types.js && node scripts/run-with-bundled-node.js scripts/prepare-public.js",
    "predev": "node scripts/run-with-bundled-node.js scripts/sync-workspace-runtime.js && node scripts/run-with-bundled-node.js scripts/prepare-public.js",
    "dev": "POKECRYSTAL_REQUIRE_SESSION_SECRET=false node scripts/run-with-bundled-node.js scripts/dev-with-logs.js",
    "build": "POKECRYSTAL_NEXT_DIST_DIR=${POKECRYSTAL_NEXT_DIST_DIR:-.next-build} node scripts/run-with-bundled-node.js scripts/clean-next-artifacts.js && POKECRYSTAL_NEXT_DIST_DIR=${POKECRYSTAL_NEXT_DIST_DIR:-.next-build} node scripts/run-with-bundled-node.js ../../node_modules/next/dist/bin/next build --webpack",
    "build:node": "npm run build",
    "audio:bundle": "node scripts/run-with-bundled-node.js scripts/generate-audio-bundle.js",
    "export:core": "npm run export:core --workspace @pokecrystal/exporters",
    "export:runtime-fallbacks": "node scripts/run-with-bundled-node.js scripts/export-runtime-fallbacks.js",
    "smoke:assets": "node scripts/run-with-bundled-node.js scripts/smoke-runtime-assets.js",
    "smoke:mcp": "bash scripts/smoke-mcp-tools-local.sh",
    "check:vercel-assets": "bash scripts/check-vercel-function-assets.sh",
    "vercel-build": "POKECRYSTAL_NEXT_DIST_DIR=.next npm run build",
    "prestart": "node scripts/run-with-bundled-node.js scripts/sync-workspace-runtime.js && node scripts/run-with-bundled-node.js scripts/prepare-public.js",
    "sync:workspace-runtime": "node scripts/run-with-bundled-node.js scripts/sync-workspace-runtime.js",
    "start": "node scripts/run-with-bundled-node.js ../../node_modules/next/dist/bin/next start",
    "lint": "npm run lint:types && npm run lint:eslint",
    "prelint:types": "node scripts/run-with-bundled-node.js scripts/emit-package-types.js",
    "lint:types": "NODE_OPTIONS=--max-old-space-size=2048 node scripts/run-with-bundled-node.js ../../node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit",
    "lint:eslint": "node scripts/run-with-bundled-node.js ../../node_modules/eslint/bin/eslint.js .",
    "test": "node scripts/run-with-bundled-node.js ../../node_modules/jest/bin/jest.js",
    "pw:install": "node scripts/run-with-bundled-node.js ../../node_modules/playwright/cli.js install chromium",
    "pw:routes": "node scripts/run-with-bundled-node.js scripts/playwright-smoke-pages.mjs routes",
    "pw:visual": "node scripts/run-with-bundled-node.js scripts/playwright-smoke-pages.mjs visual",
    "pw:visual:update": "E2E_UPDATE_BASELINES=true node scripts/run-with-bundled-node.js scripts/playwright-smoke-pages.mjs visual",
    "pw:pages": "node scripts/run-with-bundled-node.js scripts/playwright-smoke-pages.mjs routes,visual",
    "pw:pages:mobile": "E2E_DEVICE_PROFILES=iphone-13,pixel-7 node scripts/run-with-bundled-node.js scripts/playwright-smoke-pages.mjs routes,visual",
    "pw:ci": "E2E_FAIL_ON_CONSOLE_ERRORS=true E2E_FAIL_ON_PAGE_ERRORS=true E2E_FAIL_ON_REQUEST_FAILURES=true node scripts/run-with-bundled-node.js scripts/playwright-smoke-pages.mjs routes,visual",
    "pw:save": "node scripts/run-with-bundled-node.js scripts/playwright-save-path.mjs",
    "pw:game:debug": "node scripts/run-with-bundled-node.js scripts/playwright-debug-game.mjs",
    "pw:intro:capture": "node scripts/run-with-bundled-node.js scripts/playwright-capture-intro.mjs",
    "pw:oak:capture": "node scripts/run-with-bundled-node.js scripts/playwright-capture-oak-intro.mjs",
    "smoke:audio": "bash scripts/smoke-audio-convert.sh",
    "playtest:ai:mcp": "bash scripts/playtest-ai-skill-mcp.sh"
  },
  "keywords": [],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/pokecrystal-python.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/pokecrystal-python/issues"
  },
  "homepage": "https://github.com/OWNER/pokecrystal-python#readme",
  "engines": {
    "node": "24.x",
    "npm": ">=10.5.0"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pokecrystal/assets": "file:../../packages/assets",
    "@pokecrystal/core": "file:../../packages/core",
    "@pokecrystal/exporters": "file:../../packages/exporters",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tonejs/midi": "^2.0.28",
    "@vercel/speed-insights": "^1.3.1",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.0",
    "fraction.js": "^5.3.4",
    "mermaid": "^11.12.3",
    "next": "^16.1.6",
    "path-browserify": "^1.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.23",
    "babel-jest": "^30.2.0",
    "daisyui": "^5.5.19",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "madge": "^8.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
